<mvc:View
  controllerName="itsm.ui.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  xmlns:u="sap.ui.unified"
  xmlns:upload="sap.m.upload"
  displayBlock="true">

  <Page id="page" showHeader="false" backgroundDesign="Transparent" class="appBg densePage">

    <!-- ===== same styled app header as the dashboard: back button (left) · logo (click = home) · title (center) · actions (right) =====
         sap.m.Bar is single-line only in this theme (its Left/Middle/Right
         containers are height-locked); the subtitle lives just below it in
         normal page flow instead of fighting the bar for vertical space. -->
    <Bar class="appHeader">
      <contentLeft>
        <Button icon="sap-icon://nav-back" type="Transparent"
                tooltip="Back to dashboard"
                visible="{ui>/showBack}"
                press=".onBack"
                class="sapUiTinyMarginEnd"/>
        <Image src="images/ccentrik.png" height="30px" densityAware="false" class="appLogo" press=".onGoDashboard"/>
      </contentLeft>
      <contentMiddle>
        <Title text="Service Desk" class="appHeaderTitle"/>
      </contentMiddle>
      <contentRight>
        <Button text="Edit" class="saveBtn sapUiTinyMarginEnd" visible="{ui>/showEdit}" press=".onEdit"/>
        <Button text="Save" class="saveBtn sapUiTinyMarginEnd" visible="{ui>/showSave}" press=".onSave"/>
        <Button text="Submit" class="submitBtn" visible="{ui>/showSubmit}" press=".onSubmit"/>
      </contentRight>
    </Bar>
    <!-- Ticket id (or "New Ticket" before one's assigned) now lives here,
         left-aligned below the header, since the header title itself is
         the fixed app name across every page. -->
    <VBox class="pageSubtitleBlock">
      <Text text="{ui>/ticketLabel}" class="pageTicketId"/>
      <Text text="{ui>/subtitle}" class="pageSubtitle"/>
    </VBox>

    <!-- Tabs act as in-page navigation: selecting one scrolls to its section. -->
    <IconTabHeader id="tabs" mode="Inline" backgroundDesign="Transparent" select=".onTabSelect" class="sapUiSmallMarginTop">
      <items>
        <IconTabFilter text="Details" key="details"/>
        <IconTabFilter text="Description" key="description"/>
        <IconTabFilter text="Attachments" key="attachments"/>
        <IconTabFilter text="History" key="history"/>
      </items>
    </IconTabHeader>

    <VBox id="sections">

        <!-- DETAILS -->
        <VBox id="secDetails">

          <!-- ===== 1. GENERAL DATA ===== -->
          <Panel class="sectionCard" headerText="General Data" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">

              <Label text="ID"/>
              <Input value="{incidentNumber}" editable="false" placeholder="Auto-generated"/>

              <Label text="Reported By"/>
              <Input value="{reportedBy}" placeholder="Mr. Raju"/>

              <Label text="Support Team"/>
              <Input value="{supportTeam}" showValueHelp="true"/>

              <Label text="Message Processor"/>
              <Select selectedKey="{messageProcessor}" forceSelection="false" enabled="{ui>/formEditable}"
                      items="{ path: '/Agent', parameters: { $filter : &quot;active eq true&quot;, $orderby: 'name' } }">
                <core:Item key="{name}" text="{name}"/>
              </Select>

            </f:SimpleForm>

            <Label text="Description" required="true" class="sapUiSmallMarginTop"/>
            <TextArea rows="3" width="100%" editable="{ui>/formEditable}"
              value="{shortDescription}"
              placeholder="Provide the precise summary of the incident."/>
          </Panel>

          <!-- ===== 2. CATEGORY (existing implementation, unchanged) ===== -->
          <Panel class="sectionCard" headerText="Category Assignment" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">

              <!-- Cascading categories. Each level is filled by the controller
                   from the children of the level above, so depth and content
                   come purely from master data. -->
              <Label text="Category 1"/>
              <Select id="selCategory1" selectedKey="{category1_ID}"
                      items="{cat>/levels/0/items}"
                      enabled="{cat>/levels/0/enabled}"
                      busy="{cat>/levels/0/busy}"
                      busyIndicatorDelay="0"
                      forceSelection="false"
                      width="100%"
                      change=".onCategoryChange">
                <core:Item key="{cat>ID}" text="{cat>name}"/>
              </Select>
              <Text text="No subcategories available" visible="{cat>/levels/0/noChildren}" class="noSubText"/>

              <Label text="Category 2"/>
              <Select id="selCategory2" selectedKey="{category2_ID}"
                      items="{cat>/levels/1/items}"
                      enabled="{cat>/levels/1/enabled}"
                      busy="{cat>/levels/1/busy}"
                      busyIndicatorDelay="0"
                      forceSelection="false"
                      width="100%"
                      change=".onCategoryChange">
                <core:Item key="{cat>ID}" text="{cat>name}"/>
              </Select>
              <Text text="No subcategories available" visible="{cat>/levels/1/noChildren}" class="noSubText"/>

              <Label text="Category 3"/>
              <Select id="selCategory3" selectedKey="{category3_ID}"
                      items="{cat>/levels/2/items}"
                      enabled="{cat>/levels/2/enabled}"
                      busy="{cat>/levels/2/busy}"
                      busyIndicatorDelay="0"
                      forceSelection="false"
                      width="100%"
                      change=".onCategoryChange">
                <core:Item key="{cat>ID}" text="{cat>name}"/>
              </Select>
              <Text text="No subcategories available" visible="{cat>/levels/2/noChildren}" class="noSubText"/>

              <Label text="Category 4"/>
              <Select id="selCategory4" selectedKey="{category4_ID}"
                      items="{cat>/levels/3/items}"
                      enabled="{cat>/levels/3/enabled}"
                      busy="{cat>/levels/3/busy}"
                      busyIndicatorDelay="0"
                      forceSelection="false"
                      width="100%"
                      change=".onCategoryChange">
                <core:Item key="{cat>ID}" text="{cat>name}"/>
              </Select>
              <Text text="No subcategories available" visible="{cat>/levels/3/noChildren}" class="noSubText"/>

              <Label text="Solution Category"/>
              <Select selectedKey="{solutionCategory_ID}"
                      items="{ path: '/Lookup', parameters: { $filter : &quot;lookupType eq 'SOLUTION' and isActive eq true&quot;, $orderby: 'sequence' } }">
                <core:Item key="{ID}" text="{name}"/>
              </Select>

            </f:SimpleForm>
          </Panel>

          <!-- ===== 3. PROCESSING DATA ===== -->
          <Panel class="sectionCard" headerText="Processing Data" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">

              <Label text="Status"/>
              <ComboBox selectedKey="{status_ID}" enabled="{ui>/formEditable}"
                        items="{ path: '/Lookup', parameters: { $filter : &quot;lookupType eq 'STATUS' and isActive eq true&quot;, $orderby: 'sequence' } }">
                <core:Item key="{ID}" text="{name}"/>
              </ComboBox>

              <Label text="Impact" required="true"/>
              <ComboBox selectedKey="{impact_ID}" enabled="{ui>/formEditable}"
                        items="{ path: '/Lookup', parameters: { $filter : &quot;lookupType eq 'IMPACT' and isActive eq true&quot;, $orderby: 'sequence' } }">
                <core:Item key="{ID}" text="{name}"/>
              </ComboBox>

              <Label text="Urgency" required="true"/>
              <ComboBox selectedKey="{urgency_ID}" enabled="{ui>/formEditable}"
                        items="{ path: '/Lookup', parameters: { $filter : &quot;lookupType eq 'URGENCY' and isActive eq true&quot;, $orderby: 'sequence' } }">
                <core:Item key="{ID}" text="{name}"/>
              </ComboBox>

              <Label text="Recommended Priority"/>
              <Input value="{recommendedPriority}" editable="false" placeholder="Auto-suggested"/>

              <Label text="Priority" required="true"/>
              <ComboBox selectedKey="{priority_ID}" enabled="{ui>/formEditable}"
                        items="{ path: '/Lookup', parameters: { $filter : &quot;lookupType eq 'PRIORITY' and isActive eq true&quot;, $orderby: 'sequence' } }">
                <core:Item key="{ID}" text="{name}"/>
              </ComboBox>

              <Label text="SLA"/>
              <ObjectStatus
                text="{parts: ['priority/code','createdAt','firstResponseOn','completedOn'], formatter: '.formatSlaText'}"
                state="{parts: ['priority/code','createdAt','firstResponseOn','completedOn'], formatter: '.formatSlaState'}"/>

            </f:SimpleForm>
          </Panel>

          <!-- ===== 4. DATES ===== -->
          <Panel class="sectionCard" headerText="Dates" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">

              <Label text="Created"/>
              <Input value="{path: 'createdAt', formatter: '.formatDateTime'}" editable="false"/>

              <Label text="First Response By"/>
              <DateTimePicker editable="{ui>/formEditable}"
                value="{path: 'firstResponseOn', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { V4: true }}"/>

              <Label text="Due By"/>
              <DateTimePicker editable="{ui>/formEditable}"
                value="{path: 'completedOn', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { V4: true }}"/>

            </f:SimpleForm>
          </Panel>

          <!-- ===== 5. RELATIONSHIPS ===== -->
          <Panel class="sectionCard" headerText="Relationships" expandable="true" expanded="true">
            <f:SimpleForm editable="{ui>/formEditable}" layout="ColumnLayout" columnsM="2" columnsL="2" columnsXL="2">

              <Label text="Related Request for Change"/>
              <Input value="{relatedChangeRequest}" showValueHelp="true"/>

              <Label text="Configuration Item"/>
              <Input value="{configurationItem}" showValueHelp="true"/>

            </f:SimpleForm>
          </Panel>

        </VBox>

        <!-- ===== 6. DESCRIPTION ===== -->
        <VBox id="secDescription">
          <Panel class="sectionCard" headerText="Description" expandable="true" expanded="true">
            <Label text="Full Description" required="true"/>
            <TextArea rows="10" width="100%" editable="{ui>/formEditable}"
              growing="true" growingMaxLines="25"
              value="{description}"
              placeholder="Enter detailed technical notes and incident analysis..."/>
          </Panel>
        </VBox>

        <!-- ===== 7. ATTACHMENTS ===== -->
        <VBox id="secAttachments">
          <Panel class="sectionCard" headerText="Attachments" expandable="true" expanded="true">
            <upload:UploadSet
              id="attachmentUploadSet"
              instantUpload="false"
              uploadEnabled="{ui>/formEditable}"
              terminationEnabled="true"
              showIcons="true"
              items="{attachments>/list}"
              afterItemAdded=".onAttachmentAdded"
              removePressed=".onAttachmentRemove"
              openPressed=".onAttachmentDownload"
              noDataText="No attachments queued"
              noDataDescription="Drag files here or use Upload to attach them.">
              <upload:items>
                <upload:UploadSetItem
                  fileName="{attachments>fileName}"
                  mediaType="{attachments>mimeType}"
                  visibleEdit="false"
                  visibleRemove="{ui>/formEditable}"
                  enabledRemove="{ui>/formEditable}"/>
              </upload:items>
            </upload:UploadSet>
            <Text text="Maximum file size: 50MB. Supported: JPG, PNG, PDF, DOCX, XLSX" class="sapUiSmallMarginTop"/>
          </Panel>
        </VBox>

        <!-- HISTORY -->
        <VBox id="secHistory">
          <VBox class="sectionCard">
            <Text text="CHANGE HISTORY" class="sectionPill"/>
            <List id="historyTimeline" items="{hist>/list}" showSeparators="None" class="timelineList" noDataText="No changes recorded yet.">
              <CustomListItem>
                <HBox class="timelineRow">
                  <core:Icon src="{path: 'hist>changeType', formatter: '.formatHistoryIcon'}" class="timelineDot"/>
                  <VBox class="timelineBody">
                    <HBox justifyContent="SpaceBetween">
                      <Text text="{path: 'hist>changeType', formatter: '.formatHistoryTitle'}" class="timelineTitle"/>
                      <Text text="{path: 'hist>createdAt', formatter: '.formatDateTime'}" class="timelineDate"/>
                    </HBox>
                    <Text text="{parts: ['hist>changeType', 'hist>fieldLabel', 'hist>oldValue', 'hist>newValue'], formatter: '.formatHistoryText'}" class="timelineText"/>
                    <Text text="{hist>createdBy}" class="timelineUser"/>
                  </VBox>
                </HBox>
              </CustomListItem>
            </List>
          </VBox>
        </VBox>

    </VBox>

  </Page>
</mvc:View>

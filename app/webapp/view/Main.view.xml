<mvc:View
  controllerName="itsm.ui.controller.Main"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:u="sap.ui.unified"
  displayBlock="true">

  <Page id="page" showHeader="false" backgroundDesign="Transparent" class="appBg densePage">

    <!-- ===== same styled app header as the dashboard: back button (left) · logo (click = home) · title (center) · actions (right) =====
         sap.m.Bar is single-line only in this theme (its Left/Middle/Right
         containers are height-locked); the subtitle lives just below it in
         normal page flow instead of fighting the bar for vertical space. -->
    <Bar class="appHeader">
      <contentLeft>
        <Button icon="sap-icon://nav-back" type="Transparent"
                tooltip="Back to dashboard"
                visible="{ui>/showBack}"
                press=".onBack"
                class="sapUiTinyMarginEnd"/>
        <Image src="images/ccentrik.png" height="30px" densityAware="false" class="appLogo" press=".onGoDashboard"/>
      </contentLeft>
      <contentMiddle>
        <Title text="Service Desk" class="appHeaderTitle"/>
      </contentMiddle>
      <contentRight>
        <Button text="Delete" type="Negative" class="sapUiTinyMarginEnd" visible="{ui>/showDelete}" press=".onDelete"/>
        <Button text="Edit" class="saveBtn sapUiTinyMarginEnd" visible="{ui>/showEdit}" press=".onEdit"/>
        <Button text="{ui>/saveLabel}" class="saveBtn sapUiTinyMarginEnd" visible="{ui>/showSave}" enabled="{ui>/saveEnabled}" press=".onSave"/>
        <Button text="Submit" class="submitBtn" visible="{ui>/showSubmit}" press=".onSubmit"/>
      </contentRight>
    </Bar>
    <!-- Ticket id (or "New Ticket" before one's assigned) now lives here,
         left-aligned below the header, since the header title itself is
         the fixed app name across every page. -->
    <VBox class="pageSubtitleBlock">
      <Text text="{ui>/ticketLabel}" class="pageTicketId"/>
      <Text text="{= ${shortDescription} ? ${shortDescription} : ${ui>/subtitle} }" class="pageSubtitle"/>
    </VBox>

    <!-- Tabs act as in-page navigation: selecting one scrolls to its section. -->
    <IconTabHeader id="tabs" mode="Inline" backgroundDesign="Transparent" select=".onTabSelect" class="sapUiSmallMarginTop">
      <items>
        <IconTabFilter text="General &amp; Category" key="general"/>
        <IconTabFilter text="Processing &amp; Dates" key="processing"/>
        <IconTabFilter text="Relationships &amp; Description" key="relationships"/>
        <IconTabFilter text="Attachments" key="attachments"/>
        <IconTabFilter text="History" key="history"/>
      </items>
    </IconTabHeader>

    <VBox id="sections">

        <!-- ===== 1. GENERAL DATA + CATEGORY ASSIGNMENT (merged) =====
             Originally two field groups (General Data, Category Assignment)
             in one card. Merged into a single group under one pill/heading
             — the Details tab was growing too tall with 5 separate group
             headings, and these two were always filled in together anyway. -->
        <VBox id="secGeneral">
          <VBox class="sectionCard">
            <Text text="GENERAL DATA &amp; CATEGORY ASSIGNMENT" class="sectionPill"/>
            <VBox class="formGrid">

              <VBox class="formField">
                <Label text="Ticket Type"/>
                <Select selectedKey="{ticketType}" forceSelection="false" enabled="{ui>/formEditable}" width="100%"
                        items="{ path: '/LookupValues', parameters: { $filter : &quot;lookupType eq 'TICKETTYPE' and isActive eq true&quot;, $orderby: 'sequence' } }">
                  <core:Item key="{code}" text="{name}"/>
                </Select>
              </VBox>

              <VBox class="formField">
                <Label text="Reported By"/>
                <!-- Server-assigned (see beforeCreateTicket) — the reporter is
                     always the logged-in user, never free text anymore. -->
                <Input value="{path: 'reportedBy', formatter: '.formatUserName'}" editable="false" width="100%"/>
              </VBox>

              <VBox class="formField">
                <Label text="Support Team"/>
                <Select selectedKey="{supportTeam}" forceSelection="false" enabled="{ui>/formEditable}" width="100%"
                        items="{ path: '/SupportTeams', parameters: { $filter : &quot;isActive eq true&quot;, $orderby: 'name' } }">
                  <core:Item key="{teamCode}" text="{name}"/>
                </Select>
              </VBox>

              <VBox class="formField">
                <Label text="Message Processor"/>
                <Select selectedKey="{messageProcessor}" forceSelection="false" enabled="{ui>/formEditable}" width="100%"
                        items="{ path: '/Users', parameters: { $filter : &quot;isActive eq true&quot;, $orderby: 'name' } }">
                  <core:Item key="{userId}" text="{name}"/>
                </Select>
              </VBox>

              <!-- Cascading categories. Each level is filled by the controller
                   from the children of the level above, so depth and content
                   come purely from master data. Stored on the ticket as the
                   LookupValue *code* now (not its ID) — the ID is only used
                   internally to walk the parent/child hierarchy. -->
              <VBox class="formField">
                <Label text="Category 1"/>
                <Select id="selCategory1" selectedKey="{incidentForm/category1}"
                        items="{cat>/levels/0/items}"
                        enabled="{cat>/levels/0/enabled}"
                        busy="{cat>/levels/0/busy}"
                        busyIndicatorDelay="0"
                        forceSelection="false"
                        width="100%"
                        change=".onCategoryChange">
                  <core:Item key="{cat>code}" text="{cat>name}"/>
                </Select>
                <Text text="No subcategories available" visible="{cat>/levels/0/noChildren}" class="noSubText"/>
              </VBox>

              <VBox class="formField">
                <Label text="Category 2"/>
                <Select id="selCategory2" selectedKey="{incidentForm/category2}"
                        items="{cat>/levels/1/items}"
                        enabled="{cat>/levels/1/enabled}"
                        busy="{cat>/levels/1/busy}"
                        busyIndicatorDelay="0"
                        forceSelection="false"
                        width="100%"
                        change=".onCategoryChange">
                  <core:Item key="{cat>code}" text="{cat>name}"/>
                </Select>
                <Text text="No subcategories available" visible="{cat>/levels/1/noChildren}" class="noSubText"/>
              </VBox>

              <VBox class="formField">
                <Label text="Category 3"/>
                <Select id="selCategory3" selectedKey="{incidentForm/category3}"
                        items="{cat>/levels/2/items}"
                        enabled="{cat>/levels/2/enabled}"
                        busy="{cat>/levels/2/busy}"
                        busyIndicatorDelay="0"
                        forceSelection="false"
                        width="100%"
                        change=".onCategoryChange">
                  <core:Item key="{cat>code}" text="{cat>name}"/>
                </Select>
                <Text text="No subcategories available" visible="{cat>/levels/2/noChildren}" class="noSubText"/>
              </VBox>

              <VBox class="formField">
                <Label text="Category 4"/>
                <Select id="selCategory4" selectedKey="{incidentForm/category4}"
                        items="{cat>/levels/3/items}"
                        enabled="{cat>/levels/3/enabled}"
                        busy="{cat>/levels/3/busy}"
                        busyIndicatorDelay="0"
                        forceSelection="false"
                        width="100%"
                        change=".onCategoryChange">
                  <core:Item key="{cat>code}" text="{cat>name}"/>
                </Select>
                <Text text="No subcategories available" visible="{cat>/levels/3/noChildren}" class="noSubText"/>
              </VBox>

              <VBox class="formField">
                <Label text="Solution Category"/>
                <Select selectedKey="{incidentForm/solutionCategory}" width="100%"
                        items="{ path: '/LookupValues', parameters: { $filter : &quot;lookupType eq 'SOLUTION' and isActive eq true&quot;, $orderby: 'sequence' } }">
                  <core:Item key="{code}" text="{name}"/>
                </Select>
              </VBox>

              <VBox class="formField formFieldWide">
                <Label text="Description" required="true"/>
                <TextArea rows="2" width="100%" editable="{ui>/formEditable}"
                  value="{shortDescription}"
                  placeholder="Provide the precise summary of the incident."
                  class="descriptionArea"/>
              </VBox>

            </VBox>
          </VBox>
        </VBox>

        <!-- ===== 2. PROCESSING DATA + DATES (merged) =====
             Same idea as above: Processing Data and Dates were always two
             short groups sitting right next to each other — one heading
             now instead of two. -->
        <VBox id="secProcessing">
          <VBox class="sectionCard">
            <Text text="PROCESSING DATA &amp; DATES" class="sectionPill"/>
            <VBox class="formGrid">

              <!-- Draft is never a manual choice — a ticket is Draft only
                   until Submit moves it to New (see _createDraftIncident /
                   submitTicket), so the field itself is hidden while still
                   Draft, and once it's visible, Draft is excluded from the
                   pickable statuses (an agent editing an already-submitted
                   ticket shouldn't be able to send it back to Draft). -->
              <VBox class="formField" visible="{= ${status} !== 'DRAFT' }">
                <Label text="Status"/>
                <ComboBox selectedKey="{status}" enabled="{ui>/formEditable}" width="100%"
                          items="{ path: '/LookupValues', parameters: { $filter : &quot;lookupType eq 'STATUS' and isActive eq true and code ne 'DRAFT'&quot;, $orderby: 'sequence' } }">
                  <core:Item key="{code}" text="{name}"/>
                </ComboBox>
              </VBox>

              <VBox class="formField">
                <Label text="Impact" required="true"/>
                <ComboBox selectedKey="{incidentForm/impact}" enabled="{ui>/formEditable}" width="100%"
                          items="{ path: '/LookupValues', parameters: { $filter : &quot;lookupType eq 'IMPACT' and isActive eq true&quot;, $orderby: 'sequence' } }">
                  <core:Item key="{code}" text="{name}"/>
                </ComboBox>
              </VBox>

              <VBox class="formField">
                <Label text="Urgency" required="true"/>
                <ComboBox selectedKey="{incidentForm/urgency}" enabled="{ui>/formEditable}" width="100%"
                          items="{ path: '/LookupValues', parameters: { $filter : &quot;lookupType eq 'URGENCY' and isActive eq true&quot;, $orderby: 'sequence' } }">
                  <core:Item key="{code}" text="{name}"/>
                </ComboBox>
              </VBox>

              <VBox class="formField">
                <Label text="Recommended Priority"/>
                <Input value="{incidentForm/recommendedPriority}" editable="false" placeholder="Auto-suggested" width="100%"/>
              </VBox>

              <VBox class="formField">
                <Label text="Priority" required="true"/>
                <ComboBox selectedKey="{priority}" enabled="{ui>/formEditable}" width="100%"
                          items="{ path: '/LookupValues', parameters: { $filter : &quot;lookupType eq 'PRIORITY' and isActive eq true&quot;, $orderby: 'sequence' } }">
                  <core:Item key="{code}" text="{name}"/>
                </ComboBox>
              </VBox>

              <VBox class="formField">
                <Label text="SLA"/>
                <ObjectStatus
                  text="{parts: ['priority','createdAt','firstResponseAt','completedAt'], formatter: '.formatSlaText'}"
                  state="{parts: ['priority','createdAt','firstResponseAt','completedAt'], formatter: '.formatSlaState'}"
                  class="slaStatusBox"/>
              </VBox>

              <VBox class="formField">
                <Label text="Created"/>
                <Input value="{path: 'createdAt', formatter: '.formatDateTime'}" editable="false" width="100%"/>
              </VBox>

              <VBox class="formField">
                <Label text="First Response By"/>
                <DateTimePicker editable="{ui>/formEditable}" width="100%"
                  value="{path: 'firstResponseAt', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { V4: true }}"/>
              </VBox>

              <VBox class="formField">
                <Label text="Due By"/>
                <DateTimePicker editable="{ui>/formEditable}" width="100%"
                  value="{path: 'dueAt', type: 'sap.ui.model.odata.type.DateTimeOffset', constraints: { V4: true }}"/>
              </VBox>

            </VBox>
          </VBox>
        </VBox>

        <!-- ===== 3. RELATIONSHIPS + DESCRIPTION (merged) =====
             Full Description used to live in its own expandable Panel/tab;
             it now sits in the same card as Relationships (as a
             full-row field, via .formFieldWide) instead of a separate
             section, and the Panel's own expand/collapse chrome goes away
             since it never needed to be collapsed independently either. -->
        <VBox id="secRelationships">
          <VBox class="sectionCard">
            <Text text="RELATIONSHIPS &amp; DESCRIPTION" class="sectionPill"/>
            <VBox class="formGrid">

              <VBox class="formField">
                <Label text="Related Request for Change"/>
                <Input value="{incidentForm/relatedRFC}" showValueHelp="true" width="100%"/>
              </VBox>

              <VBox class="formField">
                <Label text="Configuration Item"/>
                <Input value="{incidentForm/configurationItem}" showValueHelp="true" width="100%"/>
              </VBox>

              <VBox class="formField formFieldWide">
                <Label text="Full Description" required="true"/>
                <TextArea rows="2" width="100%" editable="{ui>/formEditable}"
                  growing="true" growingMaxLines="25"
                  value="{incidentForm/description}"
                  placeholder="Enter detailed technical notes and incident analysis..."
                  class="fullDescriptionArea"/>
              </VBox>

            </VBox>
          </VBox>
        </VBox>

        <!-- ===== 4. ATTACHMENTS ===== -->
        <VBox id="secAttachments">
          <Panel class="sectionCard attachmentsPanel" headerText="Attachments" expandable="true" expanded="true">
            <MessageStrip
              text="Note: Supported file types: PDF, DOC, DOCX, XLS, XLSX, JPG, PNG, GIF, EML, MSG. Maximum Allowed Size 25MB."
              type="Information"
              showIcon="true"
              showCloseButton="false"
              class="attachmentsNote"/>

            <HBox justifyContent="SpaceBetween" alignItems="Center" class="attachmentsToolbar">
              <Text text="{attachments>/countLabel}" class="attachmentsCount"/>
              <u:FileUploader
                id="attachmentFileUploader"
                buttonOnly="true"
                iconFirst="true"
                icon="sap-icon://upload"
                buttonText="Upload"
                style="Transparent"
                multiple="true"
                enabled="{ui>/formEditable}"
                change=".onFileSelected"
                class="attachmentsUploadBtn"/>
            </HBox>

            <Table id="attachmentsTable" items="{attachments>/list}" noDataText="No data" class="attachmentsTable">
              <columns>
                <Column><Text text="Document Name" class="attachmentsColHead"/></Column>
                <Column><Text text="Document Category" class="attachmentsColHead"/></Column>
                <Column><Text text="Uploaded by" class="attachmentsColHead"/></Column>
                <Column><Text text="Uploaded on" class="attachmentsColHead"/></Column>
                <Column hAlign="Center"><Text text="Action" class="attachmentsColHead"/></Column>
              </columns>
              <items>
                <ColumnListItem>
                  <cells>
                    <Link text="{attachments>fileName}" href="{attachments>contentUrl}" target="_blank"
                          enabled="{= !!${attachments>contentUrl} }"/>
                    <Text text="{attachments>category}"/>
                    <Text text="{attachments>uploadedBy}"/>
                    <Text text="{attachments>uploadedOn}"/>
                    <Button icon="sap-icon://decline" type="Transparent" tooltip="Remove"
                            enabled="{ui>/formEditable}" press=".onAttachmentRemove"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </Panel>
        </VBox>

        <!-- HISTORY -->
        <VBox id="secHistory">
          <VBox class="sectionCard">
            <Text text="CHANGE HISTORY" class="sectionPill"/>
            <List id="historyTimeline" items="{hist>/list}" showSeparators="None" class="timelineList" noDataText="No changes recorded yet.">
              <CustomListItem>
                <HBox class="timelineItemWrap" alignItems="Center">
                  <!-- Real, in-flow connector (not a pseudo-element sitting in the
                       flex gap) so it can never be invisibly clipped by the list
                       item's own overflow box. Hidden for the very first step. -->
                  <HBox class="timelineConnector" alignItems="Center" visible="{= !${hist>__first} }">
                    <VBox class="timelineConnectorLine"/>
                  </HBox>
                  <VBox class="timelineStep">
                    <HBox class="timelineStepHead" alignItems="Center">
                      <core:Icon src="{parts: ['hist>fieldName', 'hist>oldValue'], formatter: '.formatHistoryIcon'}" class="timelineDot"/>
                      <VBox class="timelineStepHeadText">
                        <Text text="{parts: ['hist>fieldName', 'hist>oldValue'], formatter: '.formatHistoryTitle'}" class="timelineTitle"/>
                        <Text text="{path: 'hist>createdAt', formatter: '.formatDateTime'}" class="timelineDate"/>
                      </VBox>
                    </HBox>
                    <Text text="{parts: ['hist>fieldName', 'hist>oldValue', 'hist>newValue'], formatter: '.formatHistoryText'}" class="timelineText"/>
                    <Text text="{hist>changedBy}" class="timelineUser"/>
                  </VBox>
                </HBox>
              </CustomListItem>
            </List>
          </VBox>
        </VBox>

    </VBox>

  </Page>
</mvc:View>

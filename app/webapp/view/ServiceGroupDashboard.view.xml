<mvc:View
  controllerName="itsm.ui.controller.ServiceGroupDashboard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page id="sgDashboardPage" showHeader="false" backgroundDesign="Transparent" class="appBg densePage sgDash">

    <!-- ===== app header (unchanged): back · logo · title · View Tickets ===== -->
    <Bar class="appHeader">
      <contentLeft>
        <Button icon="sap-icon://nav-back" type="Transparent" tooltip="Back to dashboard" press=".onGoDashboard" class="sapUiTinyMarginEnd"/>
        <Image src="images/ccentrik.png" height="30px" densityAware="false" class="appLogo" press=".onGoDashboard"/>
      </contentLeft>
      <contentMiddle>
        <Title text="Service Group Dashboard" class="appHeaderTitle"/>
      </contentMiddle>
      <contentRight>
        <Button text="View Tickets" icon="sap-icon://menu2" class="submitBtn" press=".onGoTickets"/>
      </contentRight>
    </Bar>

    <!-- ===================== KPI ROW ===================== -->
    <HBox class="tileRow sapUiTinyMarginTop" width="100%" wrap="Wrap">
      <VBox class="kpiTileWrap"><layoutData><FlexItemData growFactor="1" baseSize="10rem"/></layoutData>
        <GenericTile header="Total Active Tickets" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc1">
          <TileContent><NumericContent value="{ops>/kpi/totalActive}" valueColor="Neutral" icon="sap-icon://sales-order" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap"><layoutData><FlexItemData growFactor="1" baseSize="10rem"/></layoutData>
        <GenericTile header="Unassigned Tickets" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc3">
          <TileContent><NumericContent value="{ops>/kpi/unassigned}" valueColor="Critical" icon="sap-icon://person-placeholder" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap"><layoutData><FlexItemData growFactor="1" baseSize="10rem"/></layoutData>
        <GenericTile header="SLA Breached" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc4">
          <TileContent><NumericContent value="{ops>/kpi/breached}" valueColor="Error" icon="sap-icon://message-error" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap"><layoutData><FlexItemData growFactor="1" baseSize="10rem"/></layoutData>
        <GenericTile header="SLA Due in Next 2 Hours" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc3">
          <TileContent><NumericContent value="{ops>/kpi/dueSoon}" valueColor="Critical" icon="sap-icon://alert" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap"><layoutData><FlexItemData growFactor="1" baseSize="10rem"/></layoutData>
        <GenericTile header="High / Critical Priority" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc4">
          <TileContent><NumericContent value="{ops>/kpi/highCritical}" valueColor="Error" icon="sap-icon://flag" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap"><layoutData><FlexItemData growFactor="1" baseSize="10rem"/></layoutData>
        <GenericTile header="Open Change Requests" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc2">
          <TileContent><NumericContent value="{ops>/kpi/changeRequests}" valueColor="Neutral" icon="sap-icon://request" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap"><layoutData><FlexItemData growFactor="1" baseSize="10rem"/></layoutData>
        <GenericTile header="Avg Resolution Time" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc1">
          <TileContent><NumericContent value="{an>/stats/avgResolution}" valueColor="Neutral" icon="sap-icon://lab" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
      <VBox class="kpiTileWrap"><layoutData><FlexItemData growFactor="1" baseSize="10rem"/></layoutData>
        <GenericTile header="First Response SLA %" frameType="OneByHalf" width="100%" state="Loaded" class="kpiTile acc6">
          <TileContent><NumericContent value="{an>/stats/compliancePercent}" scale="%" valueColor="Good" icon="sap-icon://sys-enter-2" withMargin="false"/></TileContent>
        </GenericTile>
      </VBox>
    </HBox>

    <!-- ===================== ROW 1: OVERLOAD | QUEUE | SLA ===================== -->
    <HBox class="analyticsRow sapUiTinyMarginTop" wrap="Wrap" width="100%" alignItems="Stretch">

            <!-- 1. Work Queue Summary -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <HBox justifyContent="SpaceBetween" alignItems="Center">
          <Text text="WORK QUEUE SUMMARY" class="sectionPill"/>
          <Button text="Work queue" type="Transparent" icon="sap-icon://slim-arrow-right" iconFirst="false" press=".onGoTickets"/>
        </HBox>
        <List items="{ops>/workQueue}" class="opsList" showSeparators="Inner">
          <StandardListItem icon="{ops>icon}" iconInset="false" title="{ops>label}" info="{ops>count}" infoState="{ops>state}"/>
        </List>
      </VBox>

      <!-- 2. Engineer Overload -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <HBox justifyContent="SpaceBetween" alignItems="Center">
          <Text text="ENGINEER OVERLOAD" class="sectionPill"/>
          <Button text="View all" type="Transparent" icon="sap-icon://slim-arrow-right" iconFirst="false" press=".onGoTickets"/>
        </HBox>
        <Table items="{ops>/engineers}" inset="false" fixedLayout="true" class="opsTable" noDataText="No engineers assigned yet.">
          <columns>
              <Column width="11rem">
                  <Text text="Engineer"/>
              </Column>

              <Column width="5rem" hAlign="Center">
                  <Text text="Assigned"/>
              </Column>

              <Column width="4rem" hAlign="Center">
                  <Text text="High"/>
              </Column>

              <Column width="5rem" hAlign="Center">
                  <Text text="Overdue"/>
              </Column>

              <Column width="7rem" hAlign="Center">
                  <Text text="Workload"/>
              </Column>
          </columns>    
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{ops>name}"/>
                <Text text="{ops>assigned}"/>
                <ObjectNumber number="{ops>high}" state="{= ${ops>high} &gt; 0 ? 'Error' : 'None'}"/>
                <Text text="{ops>overdue}"/>
                <ObjectStatus text="{ops>status}" state="{ops>state}" inverted="true"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>


      <!-- 3. SLA Monitor -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <Text text="SLA MONITOR" class="sectionPill"/>
        <!-- donut (~40%) beside the at-risk table (~60%), not stacked -->
        <HBox class="slaSplit" width="100%" alignItems="Start">
          <VBox class="slaDonutCol"><layoutData><FlexItemData growFactor="2" baseSize="0"/></layoutData>
            <core:HTML content="{ops>/slaSvg}" preferDOM="false"/>
            <VBox class="legend" items="{ops>/slaDonut}">
              <HBox class="leg-row" justifyContent="SpaceBetween" alignItems="Center">
                <Text text="{ops>name}" class="catName"/>
                <Text text="{ops>value}" class="catCount"/>
              </HBox>
            </VBox>
          </VBox>
          <VBox class="slaRiskCol"><layoutData><FlexItemData growFactor="3" baseSize="0"/></layoutData>
            <Text text="Top SLA at Risk" class="subPill"/>
            <Table items="{an>/atRisk}" inset="false" class="opsTable" noDataText="Nothing at risk right now.">
              <columns>
                <Column><Text text="Ticket"/></Column>
                <Column hAlign="Center"><Text text="Priority"/></Column>
                <Column hAlign="End"><Text text="Remaining"/></Column>
              </columns>
              <items>
                <ColumnListItem type="Navigation" press=".onAtRiskPress">
                  <cells>
                    <Text text="{an>ticketNumber}"/>
                    <ObjectStatus text="{an>priority}" state="{path: 'an>priority', formatter: '.formatPriorityState'}" inverted="true"/>
                    <Text text="{an>dueText}"/>
                  </cells>
                </ColumnListItem>
              </items>
            </Table>
          </VBox>
        </HBox>
      </VBox>
    </HBox>

    <!-- ===================== ROW 2: TEAM PERFORMANCE (~60%) | OPEN TICKET TREND (~40%) ===================== -->
    <HBox class="analyticsRow" wrap="Wrap" width="100%" alignItems="Stretch">

      <!-- 4. Support Team Performance -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="3" baseSize="0"/></layoutData>
        <Text text="SUPPORT TEAM PERFORMANCE" class="sectionPill"/>
        <Table items="{ops>/teams}" inset="false" class="opsTable" noDataText="No team data.">
          <columns>
            <Column><Text text="Team"/></Column>
            <Column hAlign="End"><Text text="Total"/></Column>
            <Column hAlign="End"><Text text="Open"/></Column>
            <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="High"/></Column>
            <Column hAlign="End" minScreenWidth="Tablet" demandPopin="true"><Text text="Avg Resolution"/></Column>
            <Column hAlign="End"><Text text="SLA %"/></Column>
          </columns>
          <items>
            <ColumnListItem>
              <cells>
                <Text text="{ops>name}"/>
                <Text text="{ops>total}"/>
                <Text text="{ops>open}"/>
                <Text text="{ops>high}"/>
                <Text text="{ops>avg}"/>
                <ObjectStatus text="{ops>sla}%" state="{ops>state}" inverted="true"/>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </VBox>

      <!-- 5. Open Ticket Trend -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="2" baseSize="0"/></layoutData>
        <HBox justifyContent="SpaceBetween" alignItems="Center">
          <Text text="OPEN TICKET TREND" class="sectionPill"/>
          <Select id="trendRangeSelect" width="8.5rem" selectedKey="14" change=".onTrendRangeChange">
            <core:Item key="7" text="Last 7 Days"/>
            <core:Item key="14" text="Last 14 Days"/>
            <core:Item key="30" text="Last 30 Days"/>
          </Select>
        </HBox>
        <core:HTML content="{ops>/trendSvg}" preferDOM="false"/>
        <HBox class="trendLegend" alignItems="Center">
          <VBox class="legDot dotCreated"/><Text text="Created" class="legText"/>
          <VBox class="legDot dotResolved"/><Text text="Resolved" class="legText"/>
        </HBox>
      </VBox>
    </HBox>

    <!-- ===================== ROW 3: AGING | TOP CATEGORIES | ESCALATION | ASSIGNMENT (4 equal) ===================== -->
    <HBox class="analyticsRow" wrap="Wrap" width="100%" alignItems="Stretch">

      <!-- 6. Aging Analysis -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <Text text="AGING ANALYSIS · OPEN TICKETS" class="sectionPill"/>
        <HBox alignItems="Center" class="slaMonitorRow">
          <core:HTML content="{ops>/agingSvg}" preferDOM="false"/>
          <VBox class="legend" items="{ops>/aging}">
            <HBox class="leg-row" justifyContent="SpaceBetween" alignItems="Center">
              <Text text="{ops>label}" class="catName"/>
              <Text text="{ops>count}" class="catCount"/>
            </HBox>
          </VBox>
        </HBox>
        <MessageStrip
          text="{ops>/agingOver7} tickets are older than 7 days — reassign to available engineers now."
          type="Warning" showIcon="true" class="sapUiTinyMarginTop"/>
      </VBox>

      <!-- 7. Top Categories -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <Text text="TOP CATEGORIES · OPEN" class="sectionPill"/>
        <List items="{an>/distribution/category}" class="catList" noDataText="No category data yet." growing="false">
          <CustomListItem>
            <VBox class="catRow">
              <HBox justifyContent="SpaceBetween">
                <Text text="{an>name}" class="catName"/>
                <Text text="{an>count}" class="catCount"/>
              </HBox>
              <ProgressIndicator percentValue="{an>percent}" displayValue="{an>percent}%" showValue="false" class="catBar" state="Information"/>
            </VBox>
          </CustomListItem>
        </List>
      </VBox>

      <!-- 8. Escalation Summary -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <Text text="ESCALATION SUMMARY" class="sectionPill"/>
        <List items="{ops>/escalation}" class="opsList" showSeparators="Inner">
          <StandardListItem icon="{ops>icon}" iconInset="false" title="{ops>label}" info="{ops>count}"/>
        </List>
      </VBox>

      <!-- 9. Assignment Overview -->
      <VBox class="sectionCard analyticsCard"><layoutData><FlexItemData growFactor="1" baseSize="0"/></layoutData>
        <Text text="ASSIGNMENT OVERVIEW" class="sectionPill"/>
        <List items="{ops>/assignment}" class="opsList" showSeparators="Inner">
          <StandardListItem icon="{ops>icon}" iconInset="false" title="{ops>label}" info="{ops>count}"/>
        </List>
      </VBox>
    </HBox>

  </Page>
</mvc:View>

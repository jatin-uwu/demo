<mvc:View
  controllerName="itsm.ui.controller.ServiceGroupTickets"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page id="sgTicketsPage" showHeader="false" backgroundDesign="Transparent" class="appBg densePage">

    <!-- ===== same styled app header as the other pages: back to the
         Service Group dashboard (left) · logo (home) · title (center) ===== -->
    <Bar class="appHeader">
      <contentLeft>
        <Button icon="sap-icon://nav-back" type="Transparent"
                tooltip="Back to dashboard"
                press=".onBack"
                class="sapUiTinyMarginEnd"/>
        <Image src="images/ccentrik.png" height="30px" densityAware="false" class="appLogo" press=".onBack"/>
      </contentLeft>
      <contentMiddle>
        <Title text="Service Group Tickets" class="appHeaderTitle"/>
      </contentMiddle>
      <contentRight>
        <Button text="New Ticket" icon="sap-icon://add" class="submitBtn" press=".onCreateTicket"/>
      </contentRight>
    </Bar>

    <!-- ===== Bulk assign dialog: engineer and/or team, for the selected
         tickets. Backed by the assignTickets() action (ServiceGroup only,
         see srv/service.cds). Same dialog the End User dashboard uses. ===== -->
    <Dialog id="assignDialog" title="Assign Selected Tickets" contentWidth="24rem">
      <VBox class="sapUiSmallMargin">
        <Label text="Message Processor (engineer)"/>
        <Select id="assignProcessorSelect" forceSelection="false" width="100%"
                items="{ path: '/Users', parameters: { $filter : &quot;isActive eq true&quot;, $orderby: 'name' } }">
          <core:Item key="{userId}" text="{name}"/>
        </Select>
        <Label text="Support Team" class="sapUiSmallMarginTop"/>
        <Select id="assignTeamSelect" forceSelection="false" width="100%"
                items="{ path: '/SupportTeams', parameters: { $filter : &quot;isActive eq true&quot;, $orderby: 'name' } }">
          <core:Item key="{teamCode}" text="{name}"/>
        </Select>
      </VBox>
      <beginButton>
        <Button text="Assign" type="Emphasized" press=".onConfirmAssign"/>
      </beginButton>
      <endButton>
        <Button text="Cancel" press=".onCancelAssign"/>
      </endButton>
    </Dialog>

    <VBox class="sectionCard sapUiSmallMarginTop">
      <Text text="ALL TICKETS" class="sectionPill"/>
      <Table
        id="sgTicketTable"
        inset="false"
        growing="true"
        growingThreshold="50"
        sticky="ColumnHeaders"
        mode="MultiSelect"
        items="{
          path: '/Tickets',
          parameters: {
            $orderby: 'createdAt desc'
          }
        }"
        noDataText="No tickets found.">

        <headerToolbar>
          <OverflowToolbar style="Clear">
            <Title text="Ticket List" level="H5"/>
            <ToolbarSpacer/>
            <Select id="statusFilter" width="9rem" items="{filters>/statuses}" change=".onFilterChange">
              <core:Item key="{filters>code}" text="{filters>name}"/>
            </Select>
            <Select id="priorityFilter" width="9rem" items="{filters>/priorities}" change=".onFilterChange">
              <core:Item key="{filters>code}" text="{filters>name}"/>
            </Select>
            <Select id="assigneeFilter" width="9rem" items="{filters>/assignees}" change=".onFilterChange">
              <core:Item key="{filters>code}" text="{filters>name}"/>
            </Select>
            <SearchField width="16rem" placeholder="Search # or description" search=".onSearch" liveChange=".onSearch"/>
            <Button text="Assign Selected" icon="sap-icon://key-user-settings" type="Emphasized" press=".onBulkAssign"/>
          </OverflowToolbar>
        </headerToolbar>

        <columns>
          <Column width="8rem"><Text text="Incident #"/></Column>
          <Column><Text text="Short Description"/></Column>
          <Column width="9rem"><Text text="Status"/></Column>
          <Column width="9rem"><Text text="Priority"/></Column>
          <Column width="11rem"><Text text="Assigned To"/></Column>
          <Column width="11rem"><Text text="Created On"/></Column>
        </columns>

        <items>
          <ColumnListItem type="Navigation" press=".onTicketPress">
            <cells>
              <ObjectIdentifier title="{ticketNumber}"/>
              <Text text="{shortDescription}"/>
              <ObjectStatus text="{path: 'status', formatter: '.formatStatusName'}" state="{path: 'status', formatter: '.formatStatusState'}"/>
              <ObjectStatus text="{path: 'priority', formatter: '.formatPriorityName'}" state="{path: 'priority', formatter: '.formatPriorityState'}"/>
              <Text text="{path: 'messageProcessor', formatter: '.formatUserName'}"/>
              <Text text="{ path: 'createdAt', formatter: '.formatDateTime' }"/>
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </VBox>

  </Page>
</mvc:View>

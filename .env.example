# Local SQLite + mocked-auth development (the default: `cds watch`) needs
# NONE of the variables below — this file only matters if you switch to a
# cloud/hybrid database or auth profile.
#
# Copy to `.env`, fill in real values, and never commit the copy.
# (`.env` itself is intentionally left out of the shared project handover.)

# --- PostgreSQL profile (@cap-js/postgres), if used instead of SQLite ---
DATABASE_URL=<your-postgres-connection-string>

# --- SAP BTP Cloud Foundry (hybrid/production testing) ---
# Populated automatically by `cf bind-service` / `cds bind` — do not hardcode
# real values here. Left as placeholders for reference only.
VCAP_SERVICES=<bound-automatically-by-cloud-foundry-do-not-set-manually>

{
  "name": "FORM_demo",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@cap-js/postgres": "^3.0.1",
    "@sap/cds": "^10.0.4",
    "@sap/xssec": "^4.9.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3.0.1"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "postgres",
        "pool": {
          "min": 0,
          "max": 10,
          "acquireTimeoutMillis": 30000,
          "createTimeoutMillis": 30000,
          "destroyTimeoutMillis": 5000,
          "idleTimeoutMillis": 30000
        }
      }
    }
  }
}

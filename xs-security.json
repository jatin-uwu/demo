{
  "xsappname": "form-demo",
  "tenant-mode": "dedicated",
  "description": "Security profile for the ITSM Incident Management application",
  "oauth2-configuration": {
    "redirect-uris": [
      "https://*.cfapps.us10-001.hana.ondemand.com/**"
    ]
  },
  "scopes": [
    {
      "name": "$XSAPPNAME.Agent",
      "description": "Create and process incidents"
    },
    {
      "name": "$XSAPPNAME.ServiceGroup",
      "description": "See every incident in the system and assign them to engineers"
    },
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Administer master data and all incidents"
    },
    {
      "name": "$XSAPPNAME.Consultant",
      "description": "Investigate and resolve incidents assigned to you"
    }
  ],
  "attributes": [],
  "role-templates": [
    {
      "name": "Agent",
      "description": "Service desk agent",
      "scope-references": [
        "$XSAPPNAME.Agent"
      ],
      "attribute-references": []
    },
    {
      "name": "ServiceGroup",
      "description": "Service group dispatcher",
      "scope-references": [
        "$XSAPPNAME.Agent",
        "$XSAPPNAME.ServiceGroup"
      ],
      "attribute-references": []
    },
    {
      "name": "Admin",
      "description": "Application administrator",
      "scope-references": [
        "$XSAPPNAME.Agent",
        "$XSAPPNAME.ServiceGroup",
        "$XSAPPNAME.Admin"
      ],
      "attribute-references": []
    },
    {
      "name": "Consultant",
      "description": "Engineer working assigned incidents",
      "scope-references": [
        "$XSAPPNAME.Consultant"
      ],
      "attribute-references": []
    }
  ],
  "role-collections": [
    {
      "name": "IncidentAgent",
      "description": "Service desk agent",
      "role-template-references": [
        "$XSAPPNAME.Agent"
      ]
    },
    {
      "name": "IncidentServiceGroup",
      "description": "Service group dispatcher",
      "role-template-references": [
        "$XSAPPNAME.ServiceGroup"
      ]
    },
    {
      "name": "IncidentAdmin",
      "description": "Application administrator",
      "role-template-references": [
        "$XSAPPNAME.Admin"
      ]
    },
    {
      "name": "IncidentConsultant",
      "description": "Engineer working assigned incidents",
      "role-template-references": [
        "$XSAPPNAME.Consultant"
      ]
    }
  ]
}
